# 설치한 인스턴스의 비밀이 아닌 설치 값. 공개 스크립트(이미지 스크립트와 설치본 e2e)가 읽는다. 이 파일을
# ~/.config/daegam/install.env 로 복사해 채운다(INSTALL_ENV_FILE 이 있으면 그 경로다, scripts/lib/hosts.sh 의
# install_env_file). 채운 파일은 저장소에 두지 않는다. 같은 이름의 환경 변수나 make 변수가 이긴다. 비밀번호는 여기 두지 않는다.

# kubeconfig 의 컨텍스트 이름
INSTALL_CONTEXT=my-cluster
# kubeconfig 경로. 비면 KUBECONFIG 나 ~/.kube/config 다
INSTALL_KUBECONFIG=
# 플랫폼 호스트. Ingress 앞의 DNS 와 TLS 가 이 이름을 잇는다
DAEGAM_HOST=platform.example.net
# 이미지 레지스트리(호스트/프로젝트). make push-images·image-report·registry-pull-secret·promote-images 가 쓴다
REGISTRY=registry.example.com/daegam
# 노출한 호스트의 접미사. e2e-pat·e2e-oauth 가 테넌트 default 에 노출해 둔 Gateway https://mcp-gateway.<접미사>/mcp 를
# 읽기만 한다(E2E_PAT_GW_HOST·E2E_OAUTH_GW_HOST 가 다른 host 를 준다). 둘 다 비면 그 Gateway 를 쓰는 단계를 조건부로
# 건너뛰고, host 가 있는데 그 Gateway 가 없으면 못 돈 단계로 건너뛰어 실행이 INCOMPLETE 다
EXPOSURE_DOMAIN=
# Ingress 컨트롤러(Traefik) 파드의 네임스페이스. e2e-ui-serving 이 그 Service 로 간다. 비면 traefik 이다
TRAEFIK_NAMESPACE=
# 운영자가 만든 e2e 전용 platform-admin 계정. 비밀번호는 E2E_INSTALL_PASSWORD 나 macOS 키체인 항목 daegam-e2e-install 이다
E2E_INSTALL_USER=
# e2e-install STEP 2 가 daegam-system·toolhive-system 의 모든 컨테이너에 CPU·메모리 requests·limits 를 요구하는가(true·false).
# false 면 빠진 것을 찍기만 한다
E2E_REQUIRE_LIMITS=false
# e2e-sandbox 가 게이트 동안 둘 클러스터 상한(DAEGAM_SANDBOX_MAX). 노드가 작업 공간 하나만 담으면 1 이다. 비면 두지 않는다
E2E_SANDBOX_CAPACITY=
# e2e-pat·e2e-oauth 가 노출해 둔 Gateway 의 vMCP 파드를 지워 새 파드에서 볼 수 있는가(true·false, 기본 false). false 면
# 남의 Gateway 파드를 굴리지 않고 새 키는 ready_at 까지 기다리며 회수는 30초마다 불러 잰다
E2E_POD_RESTART=false
# e2e-install-extra 가 앞뒤로 재시작 수를 보는 플랫폼 네임스페이스의 파드(공백으로 나눈다, 예: mongodb-0). 비면 보지 않는다
E2E_WATCH_RESTARTS=
