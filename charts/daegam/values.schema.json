{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daegam chart values",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "target home needs host and images.registry; target remote needs neither",
      "if": {"required": ["target"], "properties": {"target": {"const": "remote"}}},
      "else": {
        "required": ["host", "images"],
        "properties": {
          "host": {"minLength": 1},
          "images": {"required": ["registry"], "properties": {"registry": {"minLength": 1}}}
        }
      }
    },
    {
      "description": "target remote keeps llmGateway.mode off: the gateway runs on the platform's cluster",
      "if": {"required": ["target"], "properties": {"target": {"const": "remote"}}},
      "then": {"properties": {"llmGateway": {"properties": {"mode": {"enum": ["off", false]}}}}}
    },
    {
      "description": "auth.mode header needs auth.allowHeaderMode: true",
      "if": {
        "required": ["auth"],
        "properties": {"auth": {"required": ["mode"], "properties": {"mode": {"const": "header"}}}}
      },
      "then": {
        "required": ["auth"],
        "properties": {"auth": {"required": ["allowHeaderMode"], "properties": {"allowHeaderMode": {"const": true}}}}
      }
    },
    {
      "description": "auth.mode oidc needs auth.oidc.issuer",
      "if": {
        "required": ["auth"],
        "properties": {"auth": {"required": ["mode"], "properties": {"mode": {"const": "oidc"}}}}
      },
      "then": {
        "required": ["auth"],
        "properties": {
          "auth": {
            "required": ["oidc"],
            "properties": {"oidc": {"required": ["issuer"], "properties": {"issuer": {"minLength": 1}}}}
          }
        }
      }
    },
    {
      "description": "auth.mode oidc needs auth.oidc.clientId, the UI's PKCE client at the IdP: without it nobody signs in",
      "if": {
        "required": ["auth"],
        "properties": {"auth": {"required": ["mode"], "properties": {"mode": {"const": "oidc"}}}}
      },
      "then": {
        "required": ["auth"],
        "properties": {
          "auth": {
            "required": ["oidc"],
            "properties": {"oidc": {"required": ["clientId"], "properties": {"clientId": {"minLength": 1}}}}
          }
        }
      }
    },
    {
      "description": "scheme http goes only with ingress.tls none",
      "if": {"required": ["scheme"], "properties": {"scheme": {"const": "http"}}},
      "then": {
        "required": ["ingress"],
        "properties": {"ingress": {"required": ["tls"], "properties": {"tls": {"const": "none"}}}}
      }
    },
    {
      "description": "the two development switches need auth.allowHeaderMode: true",
      "if": {
        "not": {
          "required": ["auth"],
          "properties": {"auth": {"required": ["allowHeaderMode"], "properties": {"allowHeaderMode": {"const": true}}}}
        }
      },
      "then": {
        "properties": {
          "platform": {
            "properties": {
              "extraConfig": {
                "properties": {
                  "DAEGAM_ALLOW_STUB_PROVIDER": {
                    "not": {
                      "anyOf": [
                        {"const": true},
                        {"type": "string", "pattern": "^\\s*(1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn])\\s*$"}
                      ]
                    }
                  },
                  "DAEGAM_SANDBOX_ALLOW_UNCHECKED": {
                    "not": {
                      "anyOf": [
                        {"const": true},
                        {"type": "string", "pattern": "^\\s*(1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn])\\s*$"}
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "mongodb.bundled false needs secrets.platform.existingSecret",
      "if": {
        "required": ["mongodb"],
        "properties": {"mongodb": {"required": ["bundled"], "properties": {"bundled": {"const": false}}}}
      },
      "then": {
        "required": ["secrets"],
        "properties": {
          "secrets": {
            "required": ["platform"],
            "properties": {"platform": {"required": ["existingSecret"], "properties": {"existingSecret": {"minLength": 1}}}}
          }
        }
      }
    },
    {
      "description": "a generated secrets.platform needs the bundled MongoDB and a generated secrets.mongo",
      "if": {
        "required": ["secrets"],
        "properties": {
          "secrets": {
            "required": ["platform"],
            "properties": {"platform": {"required": ["existingSecret"], "properties": {"existingSecret": {"const": ""}}}}
          }
        }
      },
      "then": {
        "allOf": [
          {
            "required": ["mongodb"],
            "properties": {"mongodb": {"required": ["bundled"], "properties": {"bundled": {"const": true}}}}
          },
          {
            "required": ["secrets"],
            "properties": {
              "secrets": {
                "required": ["mongo"],
                "properties": {"mongo": {"required": ["existingSecret"], "properties": {"existingSecret": {"const": ""}}}}
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "global": {"description": "Values a parent chart shares with its subcharts. Accepted and not read."},
    "target": {
      "description": "home installs the platform; remote installs only the ServiceAccount daegam-deployer and its rights on a cluster the platform deploys into.",
      "enum": ["home", "remote"]
    },
    "host": {
      "description": "The platform host: the public URL, the Ingress host and the host that exposures may not take. Required with target home.",
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
    },
    "scheme": {"description": "The scheme browsers use to reach the host.", "enum": ["http", "https"]},
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["local", "oidc", "header"]},
        "allowHeaderMode": {"type": "boolean"},
        "adminUsername": {"type": "string"},
        "bootstrapAdminGroup": {"type": "string"},
        "mcpAudience": {"type": "string", "minLength": 1},
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {"type": "string"},
            "audience": {"type": "string"},
            "insecureHttp": {"type": "boolean"},
            "clientId": {"type": "string", "description": "The UI's public PKCE client at the IdP (DAEGAM_OIDC_CLIENT_ID). The UI signs in with it, and the platform checks that a recent sign-in's ID token was issued to it. oidc mode needs it for people to sign in."},
            "dataPlaneIssuer": {"enum": ["idp", "platform"], "description": "Whose person tokens the Gateways, exposed MCP Servers and exposed Agents accept in oidc mode: platform (the default, also when the key is missing) or idp, the way back to the IdP's tokens."},
            "confirmSeconds": {"type": "integer", "minimum": 4500, "maximum": 7776000, "description": "Not below the interactive bound DAEGAM_TURN_OWNER_CONFIRM_SECONDS (4500 by default); a smaller value stops the platform's start in oidc mode."}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "tls": {
          "description": "none, edge (a proxy in front ends TLS), or the name of a TLS Secret in the release namespace.",
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "controllerNamespace": {"type": "string"},
            "domain": {"type": "string"},
            "allowUnauthenticated": {"type": "boolean"},
            "tls": {"enum": ["", "none", "secret", "cert-manager", "edge"]}
          }
        },
        "networkPolicy": {"enum": ["", "enforced", "unenforced"]},
        "blockMetadata": {"description": "true or false; empty leaves the screen's value.", "enum": ["", true, false]},
        "resources": {"$ref": "#/definitions/homeResources"},
        "limitRange": {"$ref": "#/definitions/homeLimitRange"},
        "shippedRedis": {
          "description": "The DAEGAM_HOME_REDIS_TLS object of a Redis with TLS that runs next to the platform; empty when there is none.",
          "type": "object",
          "additionalProperties": false,
          "anyOf": [{"maxProperties": 0}, {"required": ["hosts", "port", "tls_port", "ca_configmap", "plain"]}],
          "properties": {
            "hosts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "port": {"$ref": "#/definitions/port"},
            "tls_port": {"$ref": "#/definitions/port"},
            "ca_configmap": {"type": "string", "minLength": 1},
            "plain": {"type": "boolean"}
          }
        },
        "allowRedisPlainReopen": {
          "description": "Allow home.shippedRedis.plain true while the live ConfigMap records the plain port as closed.",
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry"],
      "properties": {
        "registry": {
          "description": "Registry host and project the images are pulled from, for example registry.example.com/daegam. No default: build and push the images yourself. Required with target home.",
          "type": "string",
          "pattern": "^\\S*$"
        },
        "pullPolicy": {"enum": ["", "Always", "IfNotPresent", "Never"]},
        "pullSecret": {"type": "string"},
        "platform": {"$ref": "#/definitions/image"},
        "ui": {"$ref": "#/definitions/image"},
        "runtime": {"$ref": "#/definitions/image"},
        "agent": {"$ref": "#/definitions/image"},
        "webTools": {"$ref": "#/definitions/image"},
        "sandbox": {"$ref": "#/definitions/image"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "extraEnv": {"$ref": "#/definitions/env"},
        "extraConfig": {
          "description": "Keys added to the ConfigMap daegam-platform-config, as text or true/false.",
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$", "not": {"$ref": "#/definitions/reservedKeys"}},
          "additionalProperties": {"type": ["string", "boolean"]}
        }
      }
    },
    "docparse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "extraEnv": {"$ref": "#/definitions/env"}
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "pdb": {"$ref": "#/definitions/pdb"},
        "extraEnv": {"$ref": "#/definitions/env"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"traefikStickyCookie": {"type": "boolean"}, "annotations": {"$ref": "#/definitions/stringMap"}}
        }
      }
    },
    "mongodb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bundled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "wiredTigerCacheSizeGB": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?)?$"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"$ref": "#/definitions/secret"},
        "docparse": {"$ref": "#/definitions/secret"},
        "mongo": {"$ref": "#/definitions/secret"}
      }
    },
    "llmGateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "off or agentgateway; quote off in YAML. A bare off is the boolean false, which the schema lets through so that the templates can say how to write it.",
          "enum": ["off", "agentgateway", false]
        },
        "namespace": {
          "description": "The gateway namespace: a DNS label other than the platform's and Kubernetes' namespaces. The templates refuse those names with a message that lists them.",
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "pdb": {"$ref": "#/definitions/pdb"},
        "images": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registryPrefix": {"description": "Prefix of mirrored copies; empty pulls the references as they are.", "type": "string", "pattern": "^\\S*$"},
            "pullSecret": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"},
            "gateway": {"$ref": "#/definitions/gatewayImage"},
            "ratelimit": {"$ref": "#/definitions/gatewayImage"},
            "redis": {"$ref": "#/definitions/gatewayImage"},
            "collector": {"$ref": "#/definitions/gatewayImage"}
          }
        }
      }
    },
    "limitRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"enabled": {"type": "boolean"}, "limits": {"$ref": "#/definitions/limitRangeItems"}}
    }
  },
  "definitions": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "replicas": {"type": "integer", "minimum": 1},
    "pdb": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "not": {"anyOf": [{"$ref": "#/definitions/reservedKeys"}, {"$ref": "#/definitions/configOnlyKeys"}]}
          }
        }
      }
    },
    "quantities": {
      "type": "object",
      "propertyNames": {"enum": ["cpu", "memory", "ephemeral-storage"]},
      "additionalProperties": {"type": ["string", "number"]}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"requests": {"$ref": "#/definitions/quantities"}, "limits": {"$ref": "#/definitions/quantities"}}
    },
    "limitRangeItems": {"type": "array", "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}}}},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"}
      }
    },
    "gatewayImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "description": "repository:tag@sha256:<index digest>; the gateway holds every provider key, so each image is pinned.",
          "type": "string",
          "pattern": "^[^\\s:@$]+(:[0-9]+)?[^\\s:@$]*:[\\w][\\w.-]*@sha256:[0-9a-f]{64}$"
        },
        "signer": {"description": "The GitHub Actions workflow that signed the image keylessly; empty when it is unsigned.", "type": "string", "pattern": "^(https://\\S+)?$"}
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "description": "Name of a Secret you made. Empty: the chart generates the Secret once and keeps it.",
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
        }
      }
    },
    "reservedKeys": {
      "description": "Names the chart sets itself: every ConfigMap key it writes from its values, the keys of its Secrets and the container env it sets. Neither platform.extraConfig nor any extraEnv may use them.",
      "enum": [
        "DAEGAM_IN_CLUSTER", "DAEGAM_PLATFORM_PORT", "DAEGAM_PUBLIC_URL", "DAEGAM_AUTH_MODE", "DAEGAM_MCP_AUDIENCE",
        "DAEGAM_BOOTSTRAP_ADMIN_GROUP", "DAEGAM_OIDC_ISSUER", "DAEGAM_OIDC_AUDIENCE", "DAEGAM_OIDC_INSECURE_HTTP",
        "DAEGAM_OIDC_CLIENT_ID", "DAEGAM_DATA_PLANE_ISSUER", "DAEGAM_IDP_CONFIRM_SECONDS",
        "DAEGAM_HOME_INGRESS_ENABLED", "DAEGAM_HOME_INGRESS_CLASS", "DAEGAM_HOME_INGRESS_CONTROLLER_NAMESPACE",
        "DAEGAM_HOME_INGRESS_DOMAIN", "DAEGAM_HOME_INGRESS_ALLOW_UNAUTHENTICATED",
        "DAEGAM_HOME_INGRESS_RESERVED_HOSTS", "DAEGAM_HOME_INGRESS_TLS", "DAEGAM_HOME_NETWORK_POLICY",
        "DAEGAM_HOME_BLOCK_METADATA", "DAEGAM_HOME_RESOURCES", "DAEGAM_HOME_LIMIT_RANGE", "DAEGAM_HOME_REDIS_TLS",
        "DAEGAM_HOME_IMAGES", "DAEGAM_WEB_TOOLS_IMAGE", "DAEGAM_HOME_SANDBOX_IMAGE", "DAEGAM_MONGO_URL",
        "DAEGAM_LOCAL_BOOTSTRAP_USERNAME", "DAEGAM_LOCAL_BOOTSTRAP_PASSWORD", "DAEGAM_NAMESPACE",
        "DAEGAM_DOCPARSE_TOKEN", "DAEGAM_LLM_GATEWAY", "DAEGAM_LLM_GATEWAY_NAMESPACE", "DAEGAM_LLM_GATEWAY_IMAGES",
        "DAEGAM_LLM_GATEWAY_PDB"
      ]
    },
    "configOnlyKeys": {
      "description": "Names that come only through the ConfigMap (platform.extraConfig), because env would win over the ConfigMap that e2e gates patch.",
      "enum": [
        "DAEGAM_ALLOW_STUB_PROVIDER", "DAEGAM_SANDBOX_ALLOW_UNCHECKED", "DAEGAM_MONGO_DB", "DAEGAM_TENANT_HEADER",
        "DAEGAM_DEFAULT_TENANT", "DAEGAM_TRANSCRIPT_RETENTION_DAYS", "DAEGAM_AGENT_SCALE_TO_ZERO",
        "DAEGAM_AGENT_SLEEP_AFTER_SECONDS", "DAEGAM_AGENT_HOUSEKEEPING_HOURS", "DAEGAM_AGENT_HOUSEKEEPING_PARALLEL",
        "DAEGAM_AGENT_HOUSEKEEPING_HOLD_SECONDS", "DAEGAM_EVALUATIONS_ENABLED", "DAEGAM_EVALUATION_RUN_TOKENS",
        "DAEGAM_EVALUATION_RUNS_PER_DAY", "DAEGAM_EVALUATION_RESULT_DAYS",
        "DAEGAM_EVALUATION_GATE_CRITERIA", "DAEGAM_AGENT_CALLS_ENABLED"
      ]
    },
    "homeQuantities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}
    },
    "homeResources": {
      "description": "Requests and limits of the main container of the pods the platform runs, as quantity strings; empty, or both parts with cpu and memory.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"maxProperties": 0}, {"required": ["requests", "limits"]}],
      "properties": {"requests": {"$ref": "#/definitions/homeQuantities"}, "limits": {"$ref": "#/definitions/homeQuantities"}}
    },
    "homeLimitRange": {
      "description": "The LimitRange spec of tenant namespaces, with quantity strings; empty, or a non-empty limits list.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"maxProperties": 0}, {"required": ["limits"]}],
      "properties": {
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["Container", "Pod", "PersistentVolumeClaim"]},
              "default": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "defaultRequest": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "max": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "min": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
              "maxLimitRequestRatio": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
