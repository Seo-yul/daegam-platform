{
  "about": "P77. 캔버스(ui/src/lib/agentGraph.ts validateGraph)와 서버(platform/daegam/services/agent_graph.py validate)가 같은 그래프에 같은 이슈를 내는지 보는 묶음이다. pytest 는 tests/test_agent_graph_corpus.py, vitest 는 ui/src/test/agent-graph-corpus.test.ts 가 읽는다. 케이스의 graph 는 base 에 add_nodes·add_edges·drop_nodes(닿는 간선도 지운다)·drop_edges·data(노드 id 별 얕은 병합) 순서로 고친 것이다. 노드의 data 는 defaults[type] 위에 얕게 병합한다. context 는 base_context 의 최상위 키를 덮는다. server_only 가 있는 케이스는 캔버스가 건너뛰고 그 값이 이유다.",
  "defaults": {
    "entry": {"session_ttl_seconds": 3600, "max_turns": 50, "rate_limit": null, "max_concurrent_sessions": 100, "max_input_chars": 4000, "greeting": null},
    "agent": {"role": "main", "name": "main", "description": "", "system_prompt": "", "context": {"compaction": {"trigger": {"fraction": 0.85}, "keep": {"fraction": 0.1}}}, "max_tool_calls_per_turn": 8, "turn_timeout_seconds": 120, "retries": 2, "response_format": "text", "language": null, "builtin_tools": {"filesystem": true}},
    "model": {"name": "model", "provider": "openai-main", "model": null, "max_output_tokens": 2048, "reasoning": {"effort": "medium"}, "temperature": null, "fallback": null},
    "tools": {"source": {"kind": "gateway_instance", "id": "gw-ok"}, "allow_tools": [], "approval": {}, "timeouts": {}},
    "memory": {"checkpointer": {"data_service_id": "ds-pg"}},
    "guardrail": {"position": "input", "rules": [{"kind": "max_length", "value": 4000}], "on_violation": "block", "message": null},
    "knowledge": {"knowledge_base_id": "kb-faq", "tool_name": "search_knowledge", "description": "", "top_k": 5, "min_score": null}
  },
  "base": {
    "nodes": [
      {"id": "entry", "type": "entry", "data": {}},
      {"id": "agent-main", "type": "agent", "data": {}},
      {"id": "model-main", "type": "model", "data": {}}
    ],
    "edges": [
      {"id": "e-entry", "source": "entry", "target": "agent-main", "kind": "entry"},
      {"id": "e-model", "source": "agent-main", "target": "model-main", "kind": "model"}
    ]
  },
  "base_service": {"budget": {"session_tokens": null, "daily_tokens": null}, "observability": {"record_bodies": false}, "evaluation": null},
